{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Python App",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": [
				"python/src/main.py"
			],
			"isBackground": false
		},
		{
			"label": "C++: Build Active File",
			"type": "shell",
			"command": "C:/msys64/ucrt64/bin/g++.exe",
			"args": [
				"-std=c++17",
				"-O2",
				"-Wall",
				"-Wextra",
				"${file}",
				"-o",
				"${fileDirname}/${fileBasenameNoExtension}.exe"
			],
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
				}
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "C++: Run Active File",
			"type": "shell",
			"dependsOn": "C++: Build Active File",
			"command": "${fileDirname}/${fileBasenameNoExtension}.exe",
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": []
		}
	]
}